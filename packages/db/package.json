{
	"name": "@grocery-split/db",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"exports": {
		"import": "./src/index.ts",
		"require": null
	},
	"scripts": {
		"format": "prettier --write --ignore-unknown .",
		"lint": "eslint .",
		"build": "tsc -b",
		"db:generate": "drizzle-kit generate --name=autogenerated",
		"db:generate-custom": "drizzle-kit generate --custom --name=custom-migration-rename-me",
		"db:migrate": "drizzle-kit migrate --config=drizzle-dev.config.ts",
		"db:migrate-prod": "drizzle-kit migrate",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio --config=drizzle-dev.config.ts",
		"db:studio-prod": "drizzle-kit studio",
		"pre-commit": "lint-staged"
	},
	"devDependencies": {
		"@grocery-split/eslint-config": "workspace:*",
		"@grocery-split/prettier-config": "workspace:*",
		"@tsconfig/node-ts": "^23.6.4",
		"@tsconfig/node26": "^26.0.1",
		"@types/node": "^24.13.4",
		"dotenv": "^18.0.1",
		"drizzle-kit": "1.0.0-rc.4",
		"eslint": "^10.10.0",
		"lint-staged": "^17.5.1",
		"prettier": "3.9.6",
		"typescript": "~6.0.3"
	},
	"lint-staged": {
		"*.*": [
			"pnpm run format",
			"pnpm run lint"
		]
	},
	"prettier": "@grocery-split/prettier-config",
	"dependencies": {
		"drizzle-orm": "1.0.0-rc.4"
	}
}
