{
	"name": "@grocery-split/db",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"format": "prettier --write --ignore-unknown . '!./supabase'",
		"lint": "eslint .",
		"build": "tsc -b",
		"db:generate": "drizzle-kit generate --name=autogenerated",
		"db:generate-custom": "drizzle-kit generate --custom --name=custom-migration-rename-me",
		"db:migrate": "drizzle-kit migrate",
		"db:check": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"pre-commit": "lint-staged"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@grocery-split/prettier-config": "workspace:*",
		"@tsconfig/node-ts": "^23.6.4",
		"@tsconfig/node26": "^26.0.1",
		"@types/node": "^24.13.4",
		"dotenv": "^18.0.1",
		"drizzle-kit": "1.0.0-rc.4",
		"eslint": "^10.10.0",
		"lint-staged": "^17.5.1",
		"prettier": "3.9.6",
		"supabase": "^2.117.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.0"
	},
	"lint-staged": {
		"*.*": [
			"pnpm run format",
			"pnpm run lint"
		]
	},
	"prettier": "@grocery-split/prettier-config",
	"dependencies": {
		"drizzle-orm": "1.0.0-rc.4"
	}
}
