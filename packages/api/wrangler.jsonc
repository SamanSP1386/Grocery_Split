{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "grocery-split",
	"main": "dist/index.js",
	// Set this to today's date
	"compatibility_date": "2026-09-29",
	"compatibility_flags": ["nodejs_als"],
	// "assets": {
	// 	"binding": "ASSETS",
	// 	"directory": "dist",
	// },
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "GROCERY_SPLIT_DB",
			"database_id": "75fa1a8b-1a8b-4e1a-a5b4-f27c2d251ace"
		}
	]
}
