{
	"name": "@grocery-split/express-backend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"format": "prettier --write --ignore-unknown .",
		"lint": "eslint .",
		"dev": "node --watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.ts",
		"pre-commit": "lint-staged"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@grocery-split/prettier-config": "workspace:*",
		"@tsconfig/node-ts": "^23.6.4",
		"@tsconfig/node26": "^26.0.1",
		"@types/node": "^24.13.4",
		"eslint": "^10.10.0",
		"lint-staged": "^17.5.1",
		"prettier": "3.9.6",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.0"
	},
	"lint-staged": {
		"*.*": [
			"pnpm run format",
			"pnpm run lint"
		]
	},
	"prettier": "@grocery-split/prettier-config"
}
