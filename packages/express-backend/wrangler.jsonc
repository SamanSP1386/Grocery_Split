{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-project",
	"main": "dist/index.js",
	// Set this to today's date
	"compatibility_date": "2026-09-29",
	"compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
	// "assets": {
	// 	"binding": "ASSETS",
	// 	"directory": "dist",
	// },
	"observability": {
		"enabled": true
	}
}
